# Reusable helpers for generated specs and upstream TLA+ properties.
if(NOT DEFINED TLA2TOOLS_JAR)
  set(TLA2TOOLS_JAR "$ENV{TLA2TOOLS_JAR}" CACHE FILEPATH "Path to tla2tools.jar (enables TLC tests)")
endif()

function(jacquard_strict_cxx14 target)
  set_target_properties(${target} PROPERTIES CXX_STANDARD 14 CXX_STANDARD_REQUIRED YES CXX_EXTENSIONS NO)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /WX)
  elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(${target} PRIVATE -Wall -Wextra -Werror -pedantic-errors)
  endif()
endfunction()

function(jacquard_add_emitter target definition)
  add_executable(${target} "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/emit_tla.cpp")
  target_link_libraries(${target} PRIVATE jacquard::jacquard)
  target_compile_definitions(${target} PRIVATE "SM_DEF=\"${definition}\"" ${ARGN})
  jacquard_strict_cxx14(${target})
endfunction()

# Each invocation creates a test with an isolated model directory, TLC log and
# JSON result. An EMITTER generates the base module; MODULE and SUPPORT_MODULES
# let clients layer handwritten properties over it (or run standalone models).
# EXPECT_INVARIANT means a real counterexample is required, not just a nonzero
# exit. KIND witness documents an intentional reachability counterexample.
function(jacquard_add_tla_test)
  cmake_parse_arguments(PARSE_ARGV 0 TLA "" "NAME;EMITTER;MODULE;CONFIG;EXPECT_INVARIANT;KIND;HEAP;WORKERS;TIMEOUT" "SUPPORT_MODULES")
  if(TLA_UNPARSED_ARGUMENTS OR TLA_KEYWORDS_MISSING_VALUES OR NOT TLA_NAME OR
     (NOT TLA_EMITTER AND NOT TLA_MODULE))
    message(FATAL_ERROR "jacquard_add_tla_test: NAME and EMITTER and/or MODULE are required")
  endif()
  if(NOT TLA2TOOLS_JAR)
    return()
  endif()
  get_filename_component(jar "${TLA2TOOLS_JAR}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
  if(NOT EXISTS "${jar}" OR IS_DIRECTORY "${jar}")
    message(FATAL_ERROR "TLA2TOOLS_JAR does not name a jar: ${jar}")
  endif()
  find_package(Python3 REQUIRED COMPONENTS Interpreter)
  find_package(Java REQUIRED COMPONENTS Runtime)

  set(args --jar "${jar}" --java "${Java_JAVA_EXECUTABLE}"
           --output "${PROJECT_BINARY_DIR}/tla/${TLA_NAME}")
  if(NOT DEFINED TLA_TIMEOUT)
    set(TLA_TIMEOUT 60)
  endif()
  if(NOT TLA_TIMEOUT MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "jacquard_add_tla_test: TIMEOUT must be positive seconds")
  endif()
  if(DEFINED TLA_WORKERS)
    list(APPEND args --workers "${TLA_WORKERS}")
  endif()
  if(DEFINED TLA_HEAP)
    list(APPEND args --heap "${TLA_HEAP}")
  endif()
  list(APPEND args --timeout "${TLA_TIMEOUT}")
  math(EXPR ctest_timeout "${TLA_TIMEOUT} + 30")
  if(TLA_EMITTER)
    list(APPEND args --emitter "$<TARGET_FILE:${TLA_EMITTER}>")
  endif()
  foreach(key IN ITEMS MODULE CONFIG)
    if(TLA_${key})
      string(TOLOWER "${key}" option)
      get_filename_component(path "${TLA_${key}}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
      list(APPEND args "--${option}" "${path}")
    endif()
  endforeach()
  foreach(module IN LISTS TLA_SUPPORT_MODULES)
    get_filename_component(path "${module}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    list(APPEND args --support-module "${path}")
  endforeach()
  set(labels tla)
  if(TLA_EXPECT_INVARIANT)
    list(APPEND args --expect-invariant "${TLA_EXPECT_INVARIANT}")
    if(NOT TLA_KIND)
      set(TLA_KIND mutant)
    endif()
    list(APPEND labels counterexample "${TLA_KIND}")
  endif()
  if(TLA_KIND)
    list(APPEND args --kind "${TLA_KIND}")
  endif()
  add_test(NAME "${TLA_NAME}"
    COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/tla.py" check ${args})
  set_tests_properties("${TLA_NAME}" PROPERTIES LABELS "${labels}" TIMEOUT "${ctest_timeout}")
endfunction()
